CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
RATE_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=30
MAX_UPLOAD_MB=80
MEDIA_TTL_SECONDS=3600
MEDIA_DIR=/tmp/tikdownload-media
TIKDOWNLOAD_DB_PATH=/tmp/tikdownload.sqlite3
# PostgreSQL: set DATABASE_URL to your managed database URL
# DATABASE_URL=postgresql://tikdownload:change-me@postgres:5432/tikdownload
# S3-compatible storage: AWS S3, Cloudflare R2, or MinIO
# S3_BUCKET=tikdownload-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# Local Compose passwords (change these before any deployment)\nPOSTGRES_PASSWORD=replace-with-strong-password\nMINIO_ROOT_USER=replace-with-storage-user\nMINIO_ROOT_PASSWORD=replace-with-strong-storage-password\n# Actual retrieval provider: GetInSaver (independent third-party service)
# Obtain a key at https://developers.getinsaver.com/tiktok-downloader-api
GETINSAVER_API_KEY=replace-with-provider-key
