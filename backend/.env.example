CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
RATE_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=30
MAX_UPLOAD_MB=80
MEDIA_TTL_SECONDS=3600
MEDIA_DIR=/tmp/tikdownload-media
TIKDOWNLOAD_DB_PATH=/tmp/tikdownload.sqlite3
# Enable Redis/RQ durable queue by setting REDIS_URL and running the worker
# REDIS_URL=redis://localhost:6379/0
# TikTok retrieval is enabled only through a configured authorized provider adapter
# TIKTOK_RETRIEVAL_API_URL=https://your-provider.example/api/download
# TIKTOK_RETRIEVAL_API_TOKEN=replace-with-secret
