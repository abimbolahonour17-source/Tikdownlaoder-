# Local development frontend origin(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
RATE_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=30
MAX_UPLOAD_MB=80
MEDIA_TTL_SECONDS=3600
MEDIA_DIR=/tmp/tikdownload-media
TIKDOWNLOAD_DB_PATH=/tmp/tikdownload.sqlite3

# Managed PostgreSQL (set this for docker-compose.cloud.yml; blank uses local PostgreSQL in default Compose)
DATABASE_URL=

# Local MinIO credentials (keep the MinIO access keys in sync)
POSTGRES_PASSWORD=change-this-local-postgres-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-minio-password

# Local S3-compatible storage defaults for docker-compose.yml
S3_BUCKET=tikdownload-media
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-local-minio-password

# Supabase Storage S3-compatible configuration (recommended alternative to R2):
# Create a bucket, enable S3 protocol, and generate server-side S3 access keys in Supabase Storage settings.
# S3_BUCKET=tikdownload-videos
# S3_ENDPOINT_URL=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
# S3_REGION=<region-from-supabase>
# S3_ACCESS_KEY_ID=<supabase-s3-access-key>
# S3_SECRET_ACCESS_KEY=<supabase-s3-secret>

# For Cloudflare R2 with docker-compose.cloud.yml, replace S3 settings with:
# S3_BUCKET=your-r2-bucket
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>

# Actual retrieval provider: GetInSaver (independent third-party service)
# Obtain an API key at https://developers.getinsaver.com/tiktok-downloader-api
GETINSAVER_API_KEY=replace-with-provider-key
